# EventFlow Environment Configuration

PROJECT_NAME=EventFlow
VERSION=1.0.0
ENVIRONMENT=development

# Database
# For Local SQLite:
DATABASE_URL=sqlite:///./eventflow.db
# For Docker PostgreSQL:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/eventflow

# Redis & Celery Message Broker
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Webhook Delivery Settings
DEFAULT_TIMEOUT_SECONDS=10.0
MAX_DELIVERY_ATTEMPTS=5
BASE_BACKOFF_SECONDS=5.0
MAX_BACKOFF_SECONDS=3600.0

# Security & Secret Encryption
ALLOW_INTERNAL_NETWORKS=false
SIGNING_SECRET_PREFIX=whsec_
ENCRYPTION_KEY=dGhpc19pc19hXzI1Nl9iaXRfZW5jcnlwdGlvbl9rZXlfMTI=

# Frontend
VITE_API_URL=http://localhost:8000/api/v1

