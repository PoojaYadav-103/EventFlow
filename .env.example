# EventFlow Environment Configuration

PROJECT_NAME=EventFlow
VERSION=1.0.0
ENVIRONMENT=development

# Database
# For Local SQLite:
DATABASE_URL=sqlite:///./eventflow.db
# For Docker PostgreSQL:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/eventflow

# Redis & Celery Message Broker
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Webhook Delivery Settings (Module 2 Reliability)
MAX_DELIVERY_ATTEMPTS=5
RETRY_BASE_DELAY=5
RETRY_MAX_DELAY=3600
RETRY_JITTER=2
WEBHOOK_TIMEOUT=10
LEASE_DURATION_SECONDS=30
RETRYABLE_STATUS_CODES="408,425,429,500,502,503,504"

# Security & Secret Encryption
ALLOW_INTERNAL_NETWORKS=false
SIGNING_SECRET_PREFIX=whsec_
ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY

# Frontend
VITE_API_URL=http://localhost:8000/api/v1

